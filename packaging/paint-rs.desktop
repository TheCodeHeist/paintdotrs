[Desktop Entry]
Type=Application
Name=Paint.RS
GenericName=Image Editor
Comment=Layered image and photo editor
Exec=paint-rs %F
Icon=paint-rs
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
